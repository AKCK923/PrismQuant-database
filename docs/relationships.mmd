%% PrismQuant MongoDB collection relationship model
%% `||--o{` = 1:N reference; `}o--o{` = N:M reference
erDiagram
    users ||--o{ a5_runs : user_id
    users ||--o{ paper_accounts : user_id
    users ||--o{ research_reports : user_id
    users ||--o{ news_events : created_by
    users ||--o{ agent_state : username
    users ||--o{ agent_store : username
    instruments ||--o{ market_bars : instrument_id
    news_articles }o--o{ news_events : revisions_article_ids
    a2_people ||--o{ a2_public_records : person_id
    a2_public_records }o--o{ a5_runs : evidence_record_id
    a5_runs ||--o{ agent_context : run_id
    agent_state ||--o{ a5_runs : chat_id
    a5_runs }o--o{ research_reports : evidence_run_id
    paper_accounts ||--o{ paper_orders : account_id
    tool_skills }o--o{ a5_runs : tool_names
    news_events }o--o{ a5_runs : evidence_event_id
    a1_news_events }o--o{ a5_runs : evidence_event_id
    a5_runs ||--o{ agent_store : source_run_id

    users {
        string user_id PK
        string username UK
        string email UK
        string role
        string plan
        string plan_status
    }

    instruments {
        string instrument_id PK
        string symbol
        string asset_class
        string exchange
        string currency
        string timezone
    }

    market_bars {
        date ts
        string instrument_id FK
        string timeframe
        decimal open
        decimal high
        decimal low
        decimal close
        decimal volume
    }

    a1_news_events {
        string event_id PK
        string title
        string sentiment
        string instruments
        date published_at
        string content_hash
    }

    news_articles {
        string article_id PK
        string canonical_url UK
        string title
        date published_at
        string status
        array search_tokens
    }

    news_events {
        string event_id PK
        string title
        string status
        int latest_version
        string created_by FK
        object revisions
    }

    a2_people {
        string person_id PK
        string name_original
        string name_zh
        bool monitoring_enabled
    }

    a2_public_records {
        string record_id PK
        string person_id FK
        string title
        date published_at
        string verification_status
        object analysis
        array search_tokens
    }

    a5_runs {
        string run_id PK
        string user_id FK
        string chat_id FK
        string kind
        string mode
        bool guard_passed
        object payload
        object snapshot
        array tool_names
    }

    agent_context {
        string context_id PK
        string run_id FK
        string chat_id FK
        array messages
        array retrieved_keys
        int token_count
        date created_at
    }

    agent_state {
        string chat_id PK
        string username FK
        array messages
        object working
        string active_run_id
        string status
        date updated_at
        date last_activity_at
    }

    agent_store {
        string store_id PK
        string username FK
        string key
        object value
        string value_type
        array tags
        string source_run_id FK
        int version
        date updated_at
    }

    tool_skills {
        string name PK
        string description
        object input_schema
        object output_schema
        bool enabled
        int version
    }

    paper_accounts {
        string account_id PK
        string user_id FK
        string broker
        string mode
        decimal cash
        decimal equity
        array positions
    }

    paper_orders {
        string order_id PK
        string account_id FK
        string intent_id
        string status
        string idempotency_key UK
    }

    research_reports {
        string report_id PK
        string user_id FK
        string title
        string status
        object revisions
        date updated_at
    }
